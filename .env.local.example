# ============================================================
# LinkMeQR — desarrollo local (backend y frontend fuera de Docker)
# Copiar a .env.local y completar. Usado por:
#   - docker-compose.yml (solo MySQL + phpMyAdmin)
#   - backend corrido manualmente con `go run ./cmd/api` (carga .env.local si
#     lo copias/renombras a .env en backend/, o exporta estas variables)
# ============================================================

# --- App ---
APP_ENV=development
HTTP_PORT=8080

# --- MySQL (contenedor Docker expuesto en localhost:3306) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=linkmeqr
DB_USER=linkmeqr
DB_PASSWORD=devpassword123
MYSQL_ROOT_PASSWORD=devrootpassword123

# --- JWT ---
JWT_SECRET=dev-secret-change-in-production-abc123xyz789

# --- Frontend / URLs públicas ---
# Varios orígenes separados por coma: localhost (para ti) + tu IP LAN (para el
# teléfono). Ajusta la IP a la que te muestre `ipconfig` / la terminal del backend.
FRONTEND_ORIGIN=http://localhost:5173,http://192.168.103.139:5173
# El QR y los enlaces públicos generados usarán esta URL base. Mientras pruebas
# desde el teléfono en la misma red, usa tu IP LAN con el puerto de Vite.
PUBLIC_BASE_URL=http://192.168.103.139:5173

# --- Media / uploads ---
MEDIA_STORAGE_PATH=./media

# --- Seed del administrador inicial ---
SEED_ADMIN_EMAIL=admin@linkmeqr.com
SEED_ADMIN_PASSWORD=AdminDev123!

# --- Vite ---
VITE_API_PROXY_TARGET=http://localhost:8080
