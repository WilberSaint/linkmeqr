# ============================================================
# LinkMeQR — variables de entorno
# En el servidor: /opt/linkmeqr/.env (lo lee systemd y el propio binario).
# En local: backend/.env o .env en la raíz del repo.
# ============================================================

# --- App ---
APP_ENV=production
# En el servidor escucha solo en localhost: Caddy es quien da la cara a internet.
HTTP_HOST=127.0.0.1
HTTP_PORT=8090

# --- Base de datos (SQLite) ---
# Se crea sola al primer arranque; las migraciones van dentro del binario.
DB_PATH=/opt/linkmeqr/data/linkmeqr.db

# --- JWT ---
# Generar con: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_secret

# --- Frontend / URLs públicas ---
# Origen exacto del frontend, usado para CORS.
FRONTEND_ORIGIN=https://linkmeqr.org
# Base pública usada para construir la URL que codifica cada QR: {PUBLIC_BASE_URL}/p/{slug}
PUBLIC_BASE_URL=https://linkmeqr.org
# Frontend compilado (frontend/dist) que sirve el mismo binario. Vacío en
# desarrollo local: ahí el frontend lo sirve Vite y el shell de /p/:slug se
# pide a FRONTEND_SHELL_URL.
FRONTEND_DIST_PATH=/opt/linkmeqr/dist
# FRONTEND_SHELL_URL=http://localhost:5173/

# --- Media / uploads ---
MEDIA_STORAGE_PATH=/opt/linkmeqr/media

# --- Seed del administrador inicial (usado solo por ./seed) ---
SEED_ADMIN_EMAIL=admin@linkmeqr.com
SEED_ADMIN_PASSWORD=change_me_admin_password

# --- Vite (solo desarrollo) ---
VITE_API_PROXY_TARGET=http://localhost:8080

# --- Google Wallet (opcional) ---
# Habilita el botón "Agregar a Google Wallet" en la tarjeta de lealtad
# pública. LinkMeQR es el único emisor (Issuer) — cada negocio cliente es
# solo una "clase" dentro de esta misma cuenta, no necesita la suya propia.
# 1) Crea una cuenta Issuer en https://pay.google.com/business/console (Wallet API > Loyalty)
# 2) En Google Cloud, habilita la "Google Wallet API" y crea una cuenta de servicio
# 3) Descarga su clave JSON y toma "client_email" y "private_key" de ahí
# Si se dejan vacías, el botón simplemente no aparece — el resto de lealtad sigue funcionando igual.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=
# "UNDER_REVIEW" mientras Google aprueba la cuenta Issuer para producción; luego cambiar a "APPROVED"
GOOGLE_WALLET_REVIEW_STATUS=UNDER_REVIEW
